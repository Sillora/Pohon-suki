# Copy this file to .env.local and fill in your Aiven MySQL credentials
# (found in the Aiven console under your service's "Overview" tab)

DB_HOST=your-service.aivencloud.com
DB_PORT=your-port
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=defaultdb

# Base64-encoded contents of the Aiven CA certificate (ca.pem)
# Generate with: base64 -i ca.pem | tr -d '\n'
DB_CA_CERT=your-base64-ca-certificate
